      "hideAfterMs": 5000
    },
    "quiet": {
      "meaning": "Ambient means always available and quiet, not animated. Use status text, counts and badges",
      "forbidden": [
        "pulsing",
        "shaking",
        "auto-moving elements",
        "sound without a setting"
      ],
      "live": {
        "polite": [
          "saved",
          "counts",
          "progress milestones"
        ],
        "assertive": [
          "errors that block work"
        ]
      },
      "badgeMaxCount": 99
    },
    "optimistic": {
      "rule": "Show the result at once, label it Syncing in text, and on failure roll back with an inline message and an Undo or Retry action"
    }
  }
}
