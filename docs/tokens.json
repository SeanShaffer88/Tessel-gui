  "density": {
    "default": "comfortable",
    "perClass": {
      "dataRows": "compact",
      "toolbars": "compact",
      "trees": "compact",
      "navigation": "comfortable",
      "forms": "comfortable",
      "dialogs": "comfortable",
      "touch": "touch",
      "panelHeaders": "compact",
      "timelines": "compact",
      "meters": "compact"
    },
    "compact": {
      "panelPadding": 12,
      "controlMinHeight": 32,
      "rowMinHeight": 28
    },
    "comfortable": {
      "panelPadding": 16,
      "controlMinHeight": 40,
      "rowMinHeight": 36
    },
    "touch": {
      "panelPadding": 20,
      "controlMinHeight": 48,
      "rowMinHeight": 48
    },
    "narrowControlMinHeight": 44,
    "touchControlMinWidth": 44,
    "rule": "Density is chosen per component class, not per application. Repeated-use rows, toolbars and trees default to Compact. Forms, dialogs and primary navigation default to Comfortable. Touch applies when the input is touch."
  },
  "compartments": {
    "inspectorWidth": 300,
    "inspectorMin": 240,
    "inspectorMax": 420,
    "drawerBelowCssPixels": 901,
    "storageVersion": 1,
    "reset": "Width and collapse only; preserve other display preferences."
  },
  "effects": {
    "default": false,
    "rule": "Optional neutral decorative edge. The signature grid motif is separate and always on where defined. The deep accent fills large tinted regions with a light label. Primary actions use the action tokens. Selection and focus use their own contrast-tested colors."
  },
  "material": {
    "scope": "Opaque surfaces with shallow material relief. Dark workspace backgrounds may carry a faint static soft wood grain. Controls and state fills stay solid.",
    "dark": {
      "structuralShadow": "0 2px 3px #0003"
    },
    "light": {
      "structuralShadow": "0 2px 3px #00000014"
    },
    "primary": "Solid action fill with a white label, distinct hover and pressed states, and a 3:1 boundary against every surface.",
    "disabled": "Solid surface, muted label and dashed border.",
    "field": "Solid surface and shallow inset shadow with native control appearance.",
    "focus": "Independent 3px outline and 3px offset.",
    "forcedColors": "Use native system colors and visible outlines.",
    "texture": {
      "default": "grid",
      "options": [
        "grid",
        "flat",
        "wood"
      ],
      "rule": "Grid appears in empty states, canvases and determinate progress. Dense reading surfaces, fields and controls stay flat. Soft wood grain is an optional workspace background for dark themes."
    }
  },
  "settings": {
    "pinMinimumViewport": 1640,
    "drawerWidth": 360,
    "primaryWorkMinimumAtPinThreshold": 576,
    "sections": [
      "appearance",
      "layout",
      "shortcuts"
    ],
    "defaultSection": "appearance",
    "defaultPinned": false,
    "openState": "Transient; closed on reload",
    "appearance": "Immediate application and persistence",
    "layout": "Details width staged until Apply or Cancel; draft retained on close for visit; clean follows divider/reset, dirty remains until explicit resolution",
    "presentation": "Right-edge native modal unless pinned at a safe width; pinned column is nonmodal; saved pin retained",
    "storage": "Existing tessel.display.v1 and version 1; optional validated settingsSection and settingsPinned fields"
  },
  "actions": {
    "layout": "CSS Grid auto-fit with minimum min(100%,max(9rem,calc((100% - 8px)/2))), 1fr expansion, at most two tracks; Start spans entire first row; normal source order",
    "order": [
      "start",
      "pause/resume",
      "cancel"
    ],
    "gap": 8,
    "labels": "Wrap naturally; content determines height; no filler controls"
  },
  "surfaceAliases": {
    "surface-1": "background",
    "surface-2": "surface",
    "surface-3": "raised",
    "surface-4": "selected"
  },
