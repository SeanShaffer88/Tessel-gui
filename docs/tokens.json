  "space": {
    "unit": "CSS-pixel-equivalent; adapt to native units and user scaling",
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "compartmentGutter": 8,
    "controlGap": 8,
    "panelPadding": 12,
    "controlGapMinimum": 6,
    "relatedGroupGap": [
      12,
      16
    ],
    "sectionGap": 24,
    "scope": "Distinct grouped interactive controls, including navigation and table actions. Composite control internals follow native semantics."
  },
  "type": {
    "unit": "CSS-pixel-equivalent",
    "sans": [
      "Segoe UI",
      "system-ui",
      "sans-serif"
    ],
    "mono": [
      "Cascadia Mono",
      "Consolas",
      "monospace"
    ],
    "size": {
      "caption": 11,
      "dense": 12,
      "label": 13,
      "body": 16,
      "section": 18,
      "title": 24,
      "display": 32
    },
    "weight": {
      "regular": 400,
      "emphasis": 600
    },
    "bodyLineHeight": 1.5,
    "lineHeight": {
      "label": 1.25,
      "body": 1.5,
      "dense": 1.2,
      "title": 1.2
    },
    "letterSpacing": {
      "unit": "em",
      "body": 0,
      "capsLabel": 0.02
    },
    "numeric": {
      "tabularFigures": true,
      "align": "right",
      "monospace": "optional"
    },
    "densityRoles": {
      "compact": {
        "row": "dense",
        "control": "label"
      },
      "comfortable": {
        "row": "label",
        "control": "label"
      },
      "touch": {
        "row": "body",
        "control": "body"
      }
    },
    "truncation": {
      "singleLine": "end ellipsis with full text in a tooltip and the accessible name",
      "paths": "middle ellipsis keeping the file name",
      "wrap": "labels and body wrap; data cells truncate"
    }
  },
  "motion": {
    "unit": "milliseconds",
    "shortTransition": 120,
    "panelTransition": 180,
    "reducedMotion": "Remove nonessential transitions and preserve stable progress and status information.",
    "maximumTransition": 200,
    "duration": {
      "hover": 80,
      "press": 60,
      "expand": 160,
      "drawer": 180,
      "toast": 120
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "exit": [
        0.4,
        0,
        1,
        1
      ]
    },
    "stagger": 0,
    "reducedDuration": 0,
    "allowed": [
      "state change",
      "panel or drawer open and close",
      "determinate or indeterminate progress"
    ],
    "forbidden": [
      "ambient or looping decoration",
      "layout shift of data rows",
      "motion with no cause"
    ]
  },
  "contrast": {
    "method": "Unrounded WCAG relative luminance in linear sRGB. Test OKLCH and sRGB fallbacks independently.",
    "guidance": "materials.md#measured-palette-contract",
    "actionLabelTarget": "Label on the primary action: at least 5:1 at rest and pressed, at least 4.5:1 on hover (AA).",
    "darkSurfaceRelativeLuminanceStep": [
      0.05,
      0.1
    ],
    "distinctFillMinimum": 1.05,
    "selectedFillMinimum": 1.1,
    "focusSelectionMinimum": 1.3,
    "distinctness": "Roles that must read as different states never share a value: primary action vs raised, focus vs selection indicator, selected vs surface. Ratios are WCAG contrast between the two fills. The primary action fill also reaches 3:1 against every dark and light surface so it needs no extra boundary.",
    "actionSurfaceMinimum": 3,
    "edgeMinimum": 1.4,
    "gridRange": [
      1.04,
      1.3
    ]
  },
  "designRevision": 2,
  "lightColor": {
    "background": "#EDEDF0",
