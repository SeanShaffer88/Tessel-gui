  "signature": {
    "motif": "grid",
    "regionRule": {
      "width": 2,
      "color": "selectionIndicator",
      "scope": "Active compartment header only. One per window."
    },
    "emptyState": {
      "cell": 24,
      "line": 1,
      "color": "grid",
      "scope": "Empty states and canvases. Never behind text-dense content."
    },
    "progress": {
      "segments": 10,
      "scope": "Determinate progress shows 10 equal segments. Indeterminate progress shows a moving segment and respects reduced motion."
    },
    "accentBudget": {
      "rule": "At most one accent element per region (primary action, selection, or active rule). Syntax or data series do not use the brand accent.",
      "coverageTarget": "Informational, not a gate."
    }
  },
  "fit": {
    "rule": "Windows, dialogs, forms and wizard pages fit without scrollbars. Data containers (tables, trees, logs, editors, terminals, canvases) scroll or virtualize inside their own bounded viewport with visible position and keyboard access. The main window itself never scrolls.",
    "exemptions": [
      "tables",
      "trees",
      "logs",
      "editors",
      "terminals",
      "canvases",
      "timelines"
    ]
  },
  "workspace": {
    "modes": {
      "maximum": 9,
      "shortcut": "Ctrl/⌘+1 to 9",
      "indicator": "Structural: selection marker plus a label. Never color alone.",
      "scope": "Each mode saves its own layout. Switching never loses work."
    },
    "panels": {
      "headerHeight": 28,
      "tabHeight": 28,
      "minimumWidth": 160,
      "minimumHeight": 96,
      "dragThreshold": 4,
      "tooltipDelayMs": 500,
      "rule": "Every panel action reachable by drag also has a keyboard command and a menu item. Dock, float, move, collapse, reset."
    },
    "valueControls": {
      "fineAdjustModifier": "Shift",
      "coarseAdjustModifier": "Ctrl",
      "reset": "Double-click, or Backspace or Delete when focused",
      "keys": "Arrows step. Page Up and Page Down step by ten. Home and End go to the limits",
      "minimumTarget": 24,
      "rule": "Every slider, knob and scrubbed field shows its numeric value and unit, and has a typed-entry path."
    },
    "numerics": {
      "tabularFigures": true,
      "scope": "Timecodes, meters, rulers, tables of numbers and any value that changes in place."
    },
    "surround": {
      "color": "surround",
      "scope": "Neutral surround for color-critical viewports. Chrome next to the viewport uses the Graphite preset."
    }
  },
  "fill": {
    "rule": "Every region has a job and grows to do it. Surplus width goes to the dominant region; surplus height goes to the region that benefits most. Fill with function, never decoration. Empty states are useful states.",
    "maxEmptySpace": 40,
    "maxEmptySpaceNote": "CSS px of unused height allowed inside a region: one compact row (28) plus compact panel padding (12).",
    "emptyState": [
      "primaryAction",
      "recentItems",
      "shortcuts"
    ],
    "allowedSpace": [
      "gutter between compartments",
      "padding around a focus target",
      "neutral surround of a viewport"
    ]
  },
  "dataList": {
    "rule": "Every list of records is a table with row and column gridlines, a fixed header, right-aligned tabular figures and a marked selected row. It shows as many rows as its box allows and scrolls or virtualizes inside that box.",
    "gridlines": {
      "rows": true,
      "columns": true,
      "role": "edge"
    },
    "header": "fixed",
    "numerics": "right-aligned tabular",
    "densityClass": "dataRows",
    "selected": {
      "fill": "selected",
      "bar": "selectionIndicator",
      "barWidth": 3
    },
    "notDataLists": [
      "menus",
      "tab bars",
      "toolbars",
      "short fixed option lists"
    ]
  },
  "shortcuts": {
    "reserved": [
      {
        "id": "palette",
        "action": "Open command palette",
        "windows": "Ctrl+K",
        "macos": "Cmd+K",
        "linux": "Ctrl+K"
      },
      {
        "id": "settings",
        "action": "Open settings",
        "windows": "Ctrl+,",
        "macos": "Cmd+,",
        "linux": "Ctrl+,"
      },
      {
