  "contrast": {
    "method": "Unrounded WCAG relative luminance in linear sRGB. Test OKLCH and sRGB fallbacks independently.",
    "guidance": "materials.md#measured-palette-contract",
    "actionLabelTarget": "Label on the primary action: at least 5:1 at rest and pressed, at least 4.5:1 on hover (AA).",
    "distinctFillMinimum": 1.05,
    "selectedFillMinimum": 1.1,
    "focusSelectionMinimum": 1.3,
    "distinctness": "Roles that must read as different states never share a value, except by design in revision 3: in the dark theme the selection indicator and the focus outline are the same Carmine and are told apart by geometry (a bar or underline on the item, an outline around the control). Primary action vs raised, selected vs surface keep their ratio floors. The primary action fill is Carmine with a border rim and an off-white label; in the light theme it also reaches 3:1 against every surface.",
    "actionSurfaceMinimum": 3,
    "edgeMinimum": 1.4,
    "gridRange": [
      1.04,
      1.3
    ],
    "surfaceLuminanceStep": {
      "unit": "Relative luminance change from each surface to the next, as a ratio minus 1",
      "dark": [
        0.15,
        0.4
      ],
      "highContrast": [
        1.5,
        3
      ]
    },
    "disabledMinimum": 3,
    "textSelectionFillMinimum": 1.3,
    "findFillMinimum": 1.1,
    "highContrastTextMinimum": 7,
    "highContrastNote": "High Contrast text, semantic colors, selection and focus reach 7:1 on every surface. The primary action cannot reach both 7:1 for its label and 3:1 for its fill on black, so it carries a 2px border in `border` instead.",
    "accentIndicatorMinimum": 1.35,
    "accentIndicatorRule": "Revision 3 Carmine (#960018) is a deep, restrained accent: on the dark surfaces it measures 1.89:1 on the background, 1.81:1 on the surface, 1.72:1 on raised, 1.57:1 on the selected fill and 1.38:1 on the strong selected fill. A Carmine indicator is therefore never the only cue: the active tab also carries its label and position, the selected row also changes fill, the focused control also shows its native state, and the text cursor is off-white with only a Carmine cap. The primary action is a Carmine fill with an off-white label (7.1:1) and a 1px rim in the border role, so it never relies on fill-to-surface contrast alone.",
    "mutedRule": "Muted (#89868A) is secondary text and the code-comment color. It reaches 4.78:1 on the editor background and 4.58:1 on the surface; on raised and selected fills it measures 4.37:1 and 3.98:1, so those surfaces carry short secondary labels only and anything the user must read at length uses the foreground role. In the light theme muted reaches at least 4.5:1 on every surface."
  },
