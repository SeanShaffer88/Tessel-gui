    "fill": "surround",
    "edge": "top",
    "separator": "edge",
    "rule": "Near-black bar (the surround role). Left to right in the listed order. State that changes with the document sits left; app-wide state sits right. Every segment with an action is a button with a visible focus ring and a tooltip. Text uses the dense size in the muted role, with a small Carmine indicator beside the workspace state.",
    "indicator": {
      "role": "selectionIndicator",
      "form": "Small Carmine square beside the workspace-state segment, always paired with its text label"
    }
  },
  "states": {
