      "panelPadding": 20,
      "controlMinHeight": 48,
      "rowMinHeight": 48
    },
    "narrowControlMinHeight": 44,
    "touchControlMinWidth": 44,
    "rule": "Density is chosen per component class, not per application. Revision 3 is compact-first: rows, toolbars, trees, panel headers and primary navigation default to Compact with minimal padding. Forms and dialogs default to Comfortable. Touch applies when the input is touch."
  },
  "compartments": {
    "inspectorWidth": 300,
    "inspectorMin": 240,
    "inspectorMax": 420,
    "drawerBelowCssPixels": 901,
    "storageVersion": 1,
    "reset": "Width and collapse only; preserve other display preferences."
  },
  "effects": {
    "default": false,
    "rule": "Optional neutral decorative edge. The signature grid motif is separate and always on where defined. The deep accent is Carmine (#960018): it fills the primary action and large tinted regions with a light label. Selection and focus use Carmine as a thin edge, bar or outline, always paired with a fill change, a label or a native state."
  },
  "material": {
    "scope": "Opaque surfaces with shallow material relief. The dark background carries the fine square grid texture in empty areas, fading behind code and dense content. Controls and state fills stay solid.",
    "dark": {
      "structuralShadow": "0 2px 3px #0003"
    },
    "light": {
      "structuralShadow": "0 2px 3px #00000014"
    },
    "primary": "Solid Carmine action fill with a white label, distinct hover and pressed states, and a 1px rim in the border role so the fill never relies on surface contrast alone.",
    "disabled": "Solid surface, muted label and dashed border.",
    "field": "Solid surface and shallow inset shadow with native control appearance.",
    "focus": "Thin Carmine outline in the focus role: 2px with a 2px offset in the dark theme.",
    "forcedColors": "Use native system colors and visible outlines.",
    "texture": {
      "default": "grid",
      "options": [
        "grid",
        "flat"
      ],
      "rule": "The fine square grid (grid role, 24px cell, 1px lines) is visible in empty areas and fades behind code and dense content. Fields and controls stay flat. The wood-grain texture from revision 2 is retired."
    }
  },
