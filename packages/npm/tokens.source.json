      "dark": "#000000B3",
      "light": "#00000066",
      "use": "Behind modal dialogs only"
    }
  },
  "accentTint": {
    "method": "Mix the accent role into the background in OKLab. The tint is a quiet region fill, never a label color.",
    "roles": [
      "selectionIndicator",
      "action"
    ],
    "over": "background",
    "steps": [
      8,
      16,
      24
    ],
    "minimumLabelContrast": 4.5
  },
  "focusRing": {
    "scope": "Every focusable element shows one thin outline in the focus role (Carmine in the dark theme). Rows and tabs use the inset ring so it is never clipped by a neighbor.",
    "minimumWidth": 2,
    "color": "focus",
    "styles": {
      "outline": {
        "width": 2,
        "offset": 2,
        "placement": "outside"
      },
      "inset": {
        "width": 2,
        "offset": -2,
        "placement": "inside"
      }
    },
    "perClass": {
      "button": "outline",
      "field": "outline",
      "checkbox": "outline",
      "slider": "outline",
      "canvasHandle": "outline",
      "dataRow": "inset",
      "treeItem": "inset",
      "tab": "inset",
      "menuItem": "inset",
      "breadcrumbItem": "inset",
      "statusSegment": "inset"
    },
    "rule": "Keep the ring visible against both the control and its parent surface. On the selected fill the ring and the selection marker must both stay visible."
  },
  "table": {
